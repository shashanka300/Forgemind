# Copy to .env and fill in. Everything has a working default in mock mode.

# --- Server ---------------------------------------------------------------
FM_HOST=0.0.0.0
FM_PORT=8770
FM_DATA_DIR=forgemind-data
# Access token for the phone link. "auto" generates one per start; set a fixed
# value so bookmarks keep working across restarts.
FM_TOKEN=auto

# --- Reasoning model --------------------------------------------------------
# mock   : rule-based stand-in, no network. Exercises every tool end to end.
# meta   : Meta Model API (Muse Wonder / Muse Spark). Needs MODEL_API_KEY.
# compat : any hosted OpenAI-compatible endpoint serving Meta open weights
#          (Fireworks, Baseten, Modal - partner credits). Needs FM_COMPAT_*.
# Reasoning is an API call; the local GPU only serves the Glimmer fallback (compat).
FM_LLM_PROVIDER=mock

MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Main agent (user turns, decisions) and the cheaper worker (logging, reports,
# reading instrument displays). Check exact IDs with: forgemind check
FM_AGENT_MODEL=muse-wonder-1.0
FM_WORKER_MODEL=muse-spark-1.3
# low | medium | high (Muse Spark rejects "none"). Empty = provider default.
# low: agent-eval Oct 27 - median 2.3-2.4 s/turn vs 4.2 s default, same tool accuracy.
FM_REASONING_EFFORT=low

# Example: Fireworks. Copy the exact model id from the provider's model page.
FM_COMPAT_BASE_URL=https://api.fireworks.ai/inference/v1
FM_COMPAT_API_KEY=
FM_COMPAT_AGENT_MODEL=
FM_COMPAT_WORKER_MODEL=

# Hard cap on Meta Model API spend (USD). Every call is recorded in one ledger per
# machine (FM_LEDGER, default ~/.forgemind/ledger.sqlite); see `forgemind spend`.
# At the cap the fallback model takes over (or the agent says the budget is spent).
FM_BUDGET_USD=140
FM_LEDGER=

# Fallback when the primary errors, times out or rate-limits (PRD F-AGT-7).
# compat = the FM_COMPAT_* endpoint above, e.g. Muse Glimmer served locally by
# llama.cpp (FM_COMPAT_BASE_URL=http://localhost:8081/v1). Empty = no fallback.
FM_FALLBACK_PROVIDER=
# Seconds to stay on the fallback before retrying the primary.
FM_FALLBACK_COOLDOWN=60

# Attach the latest bench + phone frames to each agent turn (vision models).
FM_SEND_FRAMES=true

# --- Perception -------------------------------------------------------------
# clip_grid  : stand-in that works today. CLIP over image tiles on the
#              server's CPU (coarse boxes, ~1 s/frame).
# sam3       : SAM 3.1 open weights on the local GPU (target for continuous
#              perception). Needs torch (CUDA 12.8+) and the sam3 package.
# remote_sam : SAM 3 / 3.1 on a hosted GPU - deploy/modal_sam.py on Modal
#              (fallback). Needs FM_SAM_URL + FM_SAM_TOKEN.
# meta_sam   : SAM 3.1 via Meta Model API - on demand only, never per frame
#              (one concept per request). Adapter stub.
# none       : no detection (memory, chat and sessions still work).
FM_SEGMENTER=clip_grid
FM_SAM_URL=
FM_SAM_TOKEN=
FM_SAM_MIN_SCORE=0.5
# sam3 only: sam3.1 (default, the retrained 3.1 detector) | sam3 | path to a .pt file
FM_SAM_CHECKPOINT=sam3.1
FM_SAM_DEVICE=cuda

# clip : CLIP ViT-B/32 via fastembed (same as the gallery app)
# pe   : Meta Perception Encoder PE-Core-L14-336 (GPU; needs open_clip_torch).
#        Recalibrate FM_TEACH_MIN_SIM / FM_MATCH_MIN_SIM before relying on it.
# hash : tiny deterministic embedder for tests, no downloads
FM_EMBEDDER=clip
# qdrant_edge (gallery app's store) | numpy (no extra dependency)
FM_VECTOR_BACKEND=qdrant_edge

# Concepts the segmenter looks for. "person" and "hand" drive presence.
# Tuned with `forgemind concepts` (Oct 27). SAM 3.1 never answers to "soldering
# iron" (irons come out as "soldering pen" or "screwdriver"), so: keep those two
# here and TEACH your iron as "soldering iron" - the safety watch matches the
# taught name. "multimeter" also fires on digital stopwatches; teach your meter.
# Don't list "laptop"/"soldering station": SAM boxes whole scenes for them.
FM_CONCEPTS=multimeter,soldering pen,screwdriver,hex key,pliers,breadboard,circuit board,flux,person,hand,smoke

# AprilTag 36h11 marker id -> zone name. Print them with: forgemind tags
FM_ZONES={"0": "bench", "1": "shelf", "2": "drawer", "3": "cabinet", "4": "kitchen"}
# Part of the bench camera's view that is the bench (0..1 of the full frame),
# and areas inside it to ignore (e.g. an RGB keyboard). Everything downstream,
# including frames sent to the model API, sees only this. Suggest values with:
#   forgemind bench-region <sample image or video>
FM_BENCH_ROI=
FM_BENCH_MASK=
# The static camera always looks at this zone.
FM_STATIC_ZONE=bench

# --- Safety -----------------------------------------------------------------
# Built-in watch: alert when this is on the bench and nobody is there.
FM_DEFAULT_WATCH=soldering iron
FM_UNATTENDED_SECONDS=60

# --- Memory tuning ----------------------------------------------------------
# A new object needs two frames in a row before memory creates it.
FM_CONFIRM_NEW=true
# Same-object thresholds. 0.80 / 0.75 are the gallery app's CLIP values.
# For FM_EMBEDDER=pe, Assembly101 cross-camera calibration (Oct 27) gave
# teach 0.835 (89% recall at 90% precision) and match 0.90 (provisional).
# Re-run `forgemind calibrate` on your own footage before relying on them.
FM_TEACH_MIN_SIM=0.80
FM_MATCH_MIN_SIM=0.75
# Confidence halves after this many seconds without a sighting.
FM_CONFIDENCE_HALF_LIFE=1800
# Below this confidence the agent should ask for a fresh look.
FM_STALE_CONFIDENCE=0.4
